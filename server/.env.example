# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
NODE_ENV=
PORT=

# ------------------------------------------------------------------
# PostgreSQL 17-alpine (docker-compose)
#   POSTGRES_PORT is the *host* port the container's 5432 is mapped to.
#   DATABASE_URL must stay in sync with the four POSTGRES_* values.
# ------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=

# ------------------------------------------------------------------
# Redis (docker-compose)
#   REDIS_URL format: redis://:<password>@<host>:<port>
# ------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=
REDIS_URL=
# Background Redis→PG flush cadence (ms). Read paths also flush-on-demand.
CLICK_SYNC_INTERVAL_MS=

# ------------------------------------------------------------------
# Redirect rate limiting (per client IP, fixed window in Redis)
#   ALL_MAX  — circuit breaker on every GET /:code (high on purpose:
#              a viral link must never be throttled).
#   MISS_MAX — strict cap on cache misses, each of which costs one
#              Postgres lookup; this is the scanner/DoS surface.
#   TRUST_PROXY — proxy hops to trust for req.ip (0 = off, 1 behind a
#              reverse proxy). Without it all clients share one IP.
# ------------------------------------------------------------------
REDIRECT_RATE_WINDOW_S=
REDIRECT_RATE_ALL_MAX=
REDIRECT_RATE_MISS_MAX=
TRUST_PROXY=

# ------------------------------------------------------------------
# Auth (JWT)
#   Production: generate with `openssl rand -hex 64`
# ------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=

# ------------------------------------------------------------------
# Frontend
#   Expired short links 302-redirect to {FRONTEND_URL}/expired?code=…
#   Leave unset to keep returning 410 JSON instead.
# ------------------------------------------------------------------
FRONTEND_URL=

# ------------------------------------------------------------------
# Short link base — returned as `${SHORT_URL_BASE}/${shortCode}`
#   Local dev: http://localhost:3000 — production: your real domain.
# ------------------------------------------------------------------
SHORT_URL_BASE=
