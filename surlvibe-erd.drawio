        <!-- ===================== RELATIONSHIP NOTES ===================== -->
        <mxCell id="note_rel1" value="users.user_id → urls: one user creates many links (mandatory: NOT NULL).&lt;br&gt;Deleting a user cascades: all their urls (and further click_daily rows) are deleted." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note_rel2" value="urls.id → click_daily.url_id: one link has one row per UTC day.&lt;br&gt;Composite PK (url_id, day). Cascade delete removes a link’s daily history.&lt;br&gt;urls.clicks is the denormalized total kept in sync by the Redis → PG job." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
