# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------
# PostgreSQL 17-alpine (docker-compose)
#   POSTGRES_PORT is the *host* port the container's 5432 is mapped to.
#   DATABASE_URL must stay in sync with the four POSTGRES_* values.
# ------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=surlvibe
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/surlvibe
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------
# Redis (docker-compose)
#   REDIS_URL format: redis://:<password>@<host>:<port>
# ------------------------------------------------------------------
REDIS_PASSWORD=change_me
REDIS_PORT=6379
REDIS_URL=redis://:change_me@localhost:6379
# Background Redis→PG flush cadence (ms). Read paths also flush-on-demand.
CLICK_SYNC_INTERVAL_MS=1000

# ------------------------------------------------------------------
# Auth (JWT)
#   Production: generate with `openssl rand -hex 64`
# ------------------------------------------------------------------
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------------
# Frontend
#   Expired short links 302-redirect to {FRONTEND_URL}/expired?code=…
#   Leave unset to keep returning 410 JSON instead.
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Short link base — returned as `${SHORT_URL_BASE}/${shortCode}`
#   Local dev: http://localhost:3000 — production: your real domain.
# ------------------------------------------------------------------
SHORT_URL_BASE=http://localhost:3000